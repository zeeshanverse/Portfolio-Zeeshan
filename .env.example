# Local development
PORT=3001

DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portfolio

# Full connection string for Prisma. URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/portfolio

# Browser -> API connection
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_API_URL_ORIGIN=http://localhost:3000
NEXT_PUBLIC_LOCAL_IP=127.0.0.1

# Media / image storage
STORAGE_DRIVER=local
MEDIA_ROOT=var/media
MEDIA_BASE_URL=http://localhost:3001

# AI assistant. Any OpenAI-compatible endpoint can be used.
# If OPENAI_API_KEY is set, the API automatically uses OpenAI unless AI_BASE_URL is provided.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
OPENAI_API_KEY=

# Optional local LLM fallback (for a local OpenAI-compatible server such as llama.cpp)
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_API_KEY=
LLM_MODEL=gemma-4-E2B-it-Q5_K_M.gguf

# Gmail / SMTP for contact notifications
# For Gmail, use an App Password rather than your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_IGNORE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=2k22.csai.2213465@gmail.com

# Microsoft Clarity analytics
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# GlitchTip error tracking
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
